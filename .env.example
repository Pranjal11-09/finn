# Copy to .env and fill in. Never commit .env.

# Model routing (free tier is enough). Key: https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=
MODEL_CHEAP=gemini-flash-lite-latest
MODEL_STRONG=gemini-flash-latest

# Or any OpenAI-compatible endpoint (Groq, OpenRouter, local Ollama):
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=
# MODEL_CHEAP=
# MODEL_STRONG=

# Optional: push alerts to Telegram (bot via @BotFather; chat id from getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Protects /api/cron/scan. Use a long random value; set the same one as a GitHub Actions secret.
CRON_TOKEN=

# Optional: web background for newly appointed executives (push side only). Free tier: https://tavily.com
TAVILY_API_KEY=
